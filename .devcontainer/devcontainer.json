{
	"name": "roundtable-2026-08 (AI-DLC Workshop)",

	// image を指定せず、GitHub Codespaces の「既定の開発コンテナイメージ」(universal) を使用する。
	// 既定イメージ由来のコンテナ本体は Codespaces のストレージ無料枠(15GB)にカウントされない

	// プロジェクト依存の導入(prebuild でキャッシュ・package.json 更新時に再実行)
	"updateContentCommand": "npm install",

	// Claude Code はネイティブインストーラで導入(公式推奨・Node.js 非依存・署名付きバイナリ・自動更新あり)
	// 旧 devcontainer-feature は Node18+npm の旧方式で1年以上未更新のため使用しない
	"postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash",

	// Claude Code の認証情報
	"secrets": {
    "ANTHROPIC_BASE_URL": {
      "description": "LiteLLM等を使い、直接AIサービスに繋がずgatewayを通す場合の設定",
      "documentationUrl": ""
    },
    "ANTHROPIC_AUTH_TOKEN": {
      "description": "Claude CodeのAPIキー",
    }
	},

	// next dev のポートを転送
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "Next.js dev server",
			"onAutoForward": "notify"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"dbaeumer.vscode-eslint",
				"bradlc.vscode-tailwindcss",
				"esbenp.prettier-vscode",
				"cloudflare.cloudflare-workers-bindings-extension"
			]
		}
	}
}
